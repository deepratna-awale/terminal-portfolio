# Copy to terraform.tfvars (gitignored) and fill in your own values.

domain_name = "example.dev"
owner_name  = "Alex"

# Set to true after the certificate shows ISSUED (see README, "Deploy your own").
attach_custom_domain = false

github_repository = "your-github-user/terminal-portfolio"
# Only if `gh api repos/OWNER/NAME/actions/oidc/customization/sub` reports
# "use_immutable_subject": true, copy its sub_claim_prefix here.
# github_immutable_subject_prefix = "repo:your-github-user@12345678/terminal-portfolio@123456789"

# Optional: replace the default denied topics (financial, medical/legal advice,
# politics) with your own list.
# guardrail_denied_topics = [
#   {
#     name       = "Compensation"
#     definition = "Questions about salary, rates or compensation expectations."
#     examples   = ["How much do you earn?", "What is your hourly rate?"]
#   },
# Topics are checked on answers too, so avoid one that overlaps your own work.
# ]
