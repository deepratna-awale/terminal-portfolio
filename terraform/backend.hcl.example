# Copy to backend.hcl (gitignored) and run: terraform init -backend-config=backend.hcl
# The bucket is created by terraform/bootstrap (see its state_bucket output).
bucket       = "my-portfolio-tfstate-123456789012"
key          = "terminal-portfolio/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
use_lockfile = true
